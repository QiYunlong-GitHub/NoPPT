{
  "name": "@noppt/core",
  "version": "0.1.0",
  "description": "NoPPT core library - data models, types, and utilities",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./types": {
      "types": "./dist/cjs/types/index.d.ts",
      "require": "./dist/cjs/types/index.js",
      "import": "./dist/esm/types/index.js"
    },
    "./models": {
      "types": "./dist/cjs/models/index.d.ts",
      "require": "./dist/cjs/models/index.js",
      "import": "./dist/esm/models/index.js"
    },
    "./utils": {
      "types": "./dist/cjs/utils/index.d.ts",
      "require": "./dist/cjs/utils/index.js",
      "import": "./dist/esm/utils/index.js"
    },
    "./engine": {
      "types": "./dist/cjs/engine/index.d.ts",
      "require": "./dist/cjs/engine/index.js",
      "import": "./dist/esm/engine/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:ui": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.2",
    "vitest": "^1.3.1"
  }
}
