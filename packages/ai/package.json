{
  "name": "@noppt/ai",
  "version": "0.1.0",
  "description": "NoPPT AI library - model providers, agents, and templates",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./providers": {
      "types": "./dist/cjs/providers/index.d.ts",
      "require": "./dist/cjs/providers/index.js",
      "import": "./dist/cjs/providers/index.js"
    },
    "./agents": {
      "types": "./dist/cjs/agents/index.d.ts",
      "require": "./dist/cjs/agents/index.js",
      "import": "./dist/cjs/agents/index.js"
    },
    "./templates": {
      "types": "./dist/cjs/templates/index.d.ts",
      "require": "./dist/cjs/templates/index.js",
      "import": "./dist/cjs/templates/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:ui": "vitest"
  },
  "dependencies": {
    "@noppt/core": "workspace:*",
    "lucide-static": "^1.31.0",
    "jsdom": "^24.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.2",
    "vitest": "^1.3.1",
    "@types/jsdom": "^30.0.0"
  }
}
