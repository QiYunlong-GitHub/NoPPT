{
  "name": "@noppt/audit",
  "version": "0.1.0",
  "description": "NoPPT audit library - multi-engine quality audit for AI-generated presentations",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@noppt/ai": "workspace:*",
    "@noppt/core": "workspace:*",
    "axe-core": "^4.13.0",
    "playwright-core": "^1.40.0",
    "pngjs": "^6.0.0"
  },
  "devDependencies": {
    "@types/axe-core": "^3.0.6",
    "@types/pngjs": "^6.0.4",
    "typescript": "^5.4.2",
    "vitest": "^1.3.1"
  }
}
