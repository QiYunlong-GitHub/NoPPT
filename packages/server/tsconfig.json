{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmit": false,
    "lib": ["ES2021"],
    "paths": {
      "@noppt/core": ["../core/dist/cjs/index"],
      "@noppt/core/*": ["../core/dist/cjs/*"],
      "@noppt/ai": ["../ai/dist/cjs/index"],
      "@noppt/ai/*": ["../ai/dist/cjs/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "../ai/src", "../core/src"]
}
