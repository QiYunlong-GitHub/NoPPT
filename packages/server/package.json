{
  "name": "@noppt/server",
  "version": "0.1.0",
  "private": true,
  "description": "NoPPT Backend Server",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest build && tsc-alias && node dist/main.js",
    "build": "nest build && tsc-alias",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest",
    "test:e2e": "node scripts/mcp-e2e.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/serve-static": "^4.0.0",
    "@noppt/ai": "workspace:*",
    "@noppt/audit": "workspace:*",
    "@noppt/core": "workspace:*",
    "express": "^4.21.2",
    "jsdom": "^24.0.0",
    "multer": "^1.4.5-lts.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@swc-node/register": "^1.11.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.43",
    "@types/uuid": "^9.0.7",
    "esbuild": "^0.28.1",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.4.2",
    "vitest": "^1.6.0",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  }
}
