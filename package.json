{
  "name": "noppt",
  "version": "0.1.0",
  "private": true,
  "description": "NoPPT - 开源卡片式演示平台",
  "scripts": {
    "dev": "pnpm --filter @noppt/web dev",
    "dev:server": "pnpm --filter @noppt/server dev",
    "dev:all": "pnpm --filter @noppt/server --filter @noppt/web --parallel dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @noppt/web build",
    "build:server": "pnpm --filter @noppt/server build",
    "preview": "pnpm --filter @noppt/web preview",
    "start:server": "pnpm --filter @noppt/server start:prod",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint --fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:ui": "pnpm -r test:ui",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.2"
  },
  "engines": {
    "node": ">=18.17.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "volta": {
    "node": "22.23.1",
    "pnpm": "9.12.0"
  }
}
